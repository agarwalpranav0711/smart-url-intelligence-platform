# Server Environment Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Connection URL
# Format: postgres://<username>:<password>@<host>:5432/<database_name>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/url_shortener

# Optional Rate Limiting Overrides (Defaults: 60 requests per 60000 ms)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60

# Optional Pino Log Level (debug, info, warn, error)
# LOG_LEVEL=info
